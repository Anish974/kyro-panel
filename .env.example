# Copy to .env and fill in. .env is gitignored — never commit real values.
# Every key here must exist in .env or the app misbehaves in ways that look
# like Agora bugs. Values are intentionally blank.
#
# Ask Anish for the Agora credentials. Get your own Gemini key from AI Studio.
#
# DEPLOYED (render.yaml) the server process only ever reads six of these:
#   AGORA_APP_ID  AGORA_APP_CERTIFICATE  ORCHESTRATOR_API_KEY
#   LLM_BASE_URL  LLM_MODEL  LLM_API_KEY
# Everything else belongs to agent.ts, which runs on the operator's machine —
# so the Agora RESTful customer secret never reaches the deployed box.

# ---------------------------------------------------------------- Agora RTC
# App ID is public — it ships in the browser bundle and that is fine.
# App Certificate signs tokens. SERVER ONLY. It never leaves server/src/routes/token.ts.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# The channel the candidate and the agent both join.
AGORA_CHANNEL=demo-channel

# ------------------------------------------- Agora Conversational AI (REST)
# Console > RESTful API. These two are Basic-auth credentials for starting and
# stopping the voice agent. SECRET.
#   npm run agent:start -w server
#   npm run agent:stop  -w server -- <agent_id>
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# ASR and TTS keys are deliberately absent: agent.ts starts Deepgram and
# MiniMax with credential_mode 'managed', so Agora bills and authenticates
# them. Only add keys here if we ever switch a vendor to 'byo'.

# ------------------------------------------------------------- orchestrator
# Where the server listens, and where the agent script reaches it locally.
PORT=8787
SERVER_URL=http://localhost:8787

# The public URL Agora calls our /chat/completions on. Agora runs in the cloud
# and cannot see localhost, so this is either:
#
#   Deployed (preferred) — the Render URL, e.g. https://kyro-panel.onrender.com
#                          Set it once and it never changes again.
#   Tunnel (local only)  — `npm run tunnel`, and cloudflared prints a NEW
#                          hostname every restart. Update this line and restart
#                          the agent. A stale value is the usual cause of a
#                          silent panel.
#
# SERVER_URL above points at the same place when deployed — the web app and the
# API share one origin.
ORCHESTRATOR_URL=

# Bearer token Agora sends back to us as the Authorization header on every LLM
# call. Set it to any long random string. requireSecret (server/src/routes/auth.ts)
# checks it on /chat/completions and /reset, and a server started without it
# refuses those routes with a 503 rather than running open.
ORCHESTRATOR_API_KEY=

# ---------------------------------------------------------------------- LLM
# One code path for both providers: Gemini exposes an OpenAI-compatible API,
# so switching providers is three lines here and zero lines of code.
#
# Gemini (default — free tier, fastest tier available to us).
# Pinned, not "-latest": a model that changes under us mid-demo is not a feature.
# NOTE: the 2.5 models are closed to new keys — they 404 with "no longer available".
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# OpenAI (backup — uncomment these two, swap the key above)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ----------------------------------------------------------------- Supabase
# Postgres, so scheduled interviews and finished scorecards survive a restart.
# Leave it blank and the server keeps both in memory instead — every self-check
# runs that way, and a fresh checkout works before anyone has a database.
#
# Supabase > Project Settings > Database > Connection string > URI.
# If the password contains @ : / or ?, percent-encode it (@ becomes %40).
# An un-encoded @ makes the driver read the rest as the hostname and fail with a
# DNS error that says nothing about the password.
#
# Apply the schema once:  npm run db:setup -w server
DATABASE_URL=

# Project REST endpoint and browser-side keys. Nothing uses them yet — the
# server owns every read and write and talks straight to Postgres. Both are
# public by design, which is why every table has RLS enabled and no policies:
# PostgREST serves nothing to these keys. See server/src/db/schema.sql.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Bypasses RLS completely — every row of every table. Never in a browser, a log
# line, or a repo. Only needed once candidate files go into Storage; leave blank
# until then.
SUPABASE_SERVICE_ROLE_KEY=
